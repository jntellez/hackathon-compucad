{
  "name": "hackathon-compucad",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @compucad/api --filter @compucad/web dev",
    "dev:web": "pnpm --filter @compucad/web dev",
    "dev:api": "pnpm --filter @compucad/api dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "./scripts/prisma-cli.sh migrate dev",
    "db:seed": "./scripts/prisma-cli.sh db seed",
    "db:studio": "pnpm --filter @compucad/api prisma studio --browser none --port 5555",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "postinstall": "pnpm --filter @compucad/api prisma generate"
  }
}
