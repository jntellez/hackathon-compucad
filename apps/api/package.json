{
  "name": "@compucad/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Compucad Training Agent project.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm prisma generate && tsx watch src/server.ts",
    "build": "pnpm prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm prisma generate && tsc --noEmit",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  }
}
